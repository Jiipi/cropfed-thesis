FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[api]"

RUN useradd --create-home --uid 10001 cropfed \
    && mkdir -p /app/artifacts \
    && chown -R cropfed:cropfed /app
USER cropfed

EXPOSE 8000
CMD ["uvicorn", "cropfed.api.main:app", "--host", "0.0.0.0", "--port", "8000"]

